{
  "version": 2,
  "builds": [
    { "src": "backend/vercel.js", "use": "@vercel/node" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/vercel.js" },
    { "src": "/", "dest": "/frontend/login.html" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-debit",
      "schedule": "0 3 * * *"
    }
  ]
}
